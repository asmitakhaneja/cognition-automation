# Devin Observability Dashboard — backend configuration
#
# The dashboard reads from the organization-scoped Devin API
# (/v3/organizations/{org_id}/...), so live data needs BOTH values below.
# Leave them unset to run on the built-in demo dataset.
#
# Supported credentials (sent as `Authorization: Bearer <key>`):
#   - v3 service-user token   (cog_...)
#   - personal API key        (apk_user_...)
DEVIN_API_KEY=

# Devin organization id (org-...) — required for live data + webhook orchestration.
DEVIN_ORG_ID=

# --- Webhook automation (GitHub issues -> Devin sessions) ---
# The repo whose `devin-fix` issues trigger remediation sessions.
GITHUB_REPO=asmitakhaneja/superset
# Optional GitHub token (avoids the 60 req/hr unauthenticated rate limit).
GITHUB_TOKEN=
# Shared secret used to verify webhook signatures (recommended).
GITHUB_WEBHOOK_SECRET=
# Only issues carrying this label are remediated.
TRIGGER_LABEL=devin-fix
# How often the background poller refreshes session status/PRs (seconds).
POLL_INTERVAL_SEC=30
# Where webhook-triggered session state is persisted.
# STORE_PATH=/app/data/state.json

# --- Optional dashboard overrides ---
# DEVIN_API_BASE_URL=https://api.devin.ai
# DEVIN_API_TIMEOUT=30
# DEVIN_DASHBOARD_FORCE_MOCK=0
